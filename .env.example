# Use bash scripts/setup.sh for generated credentials and restricted grants.
# Never use your TeslaMate database owner or Tesla API credentials here.
TESLAMATE_NETWORK=teslamate_default
PGHOST=database
PGPORT=5432
PGDATABASE=teslamate
PGUSER=mate4mobile_reader
PGPASSWORD=replace-with-a-generated-database-password
APP_PASS=replace-with-a-long-unique-dashboard-passphrase
APP_SECRET=replace-with-at-least-32-random-characters
TZ=Europe/London
CURRENCY=GBP
# Optional: choose one TeslaMate car; otherwise the first car is used.
# CAR_ID=1
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8099
# Keep 1 for HTTPS. Set 0 ONLY for localhost development.
COOKIE_SECURE=1
# Optional exact proxy IPs, comma-separated. Never put public clients here.
# TRUSTED_PROXY_IPS=172.20.0.2
